# CVSmith production settings. setup.sh creates deploy/.env.prod from this and fills the
# secrets. Never commit .env.prod or paste its contents anywhere.

# Your domain, without https:// (its DNS A record must point at this server).
DOMAIN=cvsmith.example.com

# Pilot: only invited emails can log in (python -m app.cli invites add ...).
INVITE_ONLY=true

# Email (login codes). Resend over SMTP: the password is your Resend API key.
EMAIL_PROVIDER=smtp
EMAIL_FROM=CVSmith <login@cvsmith.example.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

# Claude API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Google sign-in (optional): OAuth client ID with https://DOMAIN as an allowed origin.
GOOGLE_OAUTH_CLIENT_ID=

# Generated by setup.sh; keep them secret and stable (changing JWT_SECRET logs everyone out).
JWT_SECRET=
POSTGRES_PASSWORD=
