# Backend environment. Copy to .env.
ENVIRONMENT=development          # non-development REQUIRES a strong JWT_SECRET
DATABASE_URL=sqlite:///./cvsmith.db   # prod: postgresql+psycopg2://user:pass@host:5432/cvsmith
JWT_SECRET=dev-insecure-secret-change-me   # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
GOOGLE_OAUTH_CLIENT_ID=
# Email (login codes). EMAIL_PROVIDER: log | sendgrid | smtp. Empty: sendgrid if SENDGRID_API_KEY is set, else log.
# "log" writes the code to the backend log, development only. "smtp" works with Resend, Brevo, Mailgun, Amazon SES.
EMAIL_PROVIDER=
EMAIL_FROM=noreply@cvsmith.com   # an address on a domain you verified with the provider
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
# CV parsing (background worker)
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=               # from console.anthropic.com; never commit a real key
CVSMITH_CLAUDE_KEY=              # alternative name where ANTHROPIC_* is reserved (Claude Code cloud); wins if set
CLAUDE_MODEL=claude-sonnet-5-5
SUGGESTION_MODEL=claude-sonnet-5-5
# PDF download: the backend's Chromium loads print.html from the frontend (default FRONTEND_URL).
PDF_TEMPLATE_URL=
PDF_CHROMIUM_PATH=               # optional: a Chromium to use instead of Playwright's own
